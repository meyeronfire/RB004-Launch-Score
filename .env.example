# Public origin. Use the exact HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL. Required for production scans, Stripe checkout, and the worker.
DATABASE_URL=
RATE_LIMIT_SALT=

# Optional scan enrichments. Missing services appear as unavailable/unknown in reports.
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
PAGESPEED_API_KEY=

# Optional paid reports. Checkout stays unavailable until all delivery variables exist.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Generate 32 random bytes and encode them with base64. Keep this stable for stored outbox jobs.
REPORT_TOKEN_ENCRYPTION_KEY=

# Self-hosted production only: name of the trusted reverse-proxy header containing the client IP.
# Vercel uses its platform-assigned x-vercel-forwarded-for header automatically.
TRUSTED_PROXY_IP_HEADER=

# Local development only: use an installed browser if Playwright's browser is unavailable.
# Production worker ignores these and requires the isolated Linux launcher.
# PLAYWRIGHT_CHANNEL=chrome
# PLAYWRIGHT_EXECUTABLE_PATH=
SCAN_WORKER_ID=

# Optional Plausible events (no tracker is loaded when the domain is blank).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
